<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Framework dark Material theme. Compose (Material3) supplies the real UI theming;
         this XML theme only styles the window background / bars before Compose draws. -->
    <style name="Theme.DDNAS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ddnas_dark_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
