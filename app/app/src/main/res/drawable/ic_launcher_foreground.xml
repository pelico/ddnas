<?xml version="1.0" encoding="utf-8"?>
<!-- DDNAS 前景图标：云（上）+ 单层 NAS 主机（下），几何对称、居中规整。
     Adaptive-icon safe-zone: 中心 72x72（x=18..90, y=18..90），所有元素居中于 x=54。
     设计原则：少元素、大色块、严格对称，小尺寸下仍清晰可辨。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ========== 云朵：左/中/右三圆 + 底部圆角条，白色叠加成云剪影 ==========
         左右圆对称（r=8），中圆稍大稍高（r=9），底部条圆角收口。 -->
    <!-- 左圆 cx=45 cy=37 r=8 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M37,37 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 z" />
    <!-- 中圆 cx=54 cy=33 r=9 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M45,33 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 z" />
    <!-- 右圆 cx=63 cy=37 r=8 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M55,37 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 z" />
    <!-- 底部圆角条 x=37..71 y=37..48（与三圆底部重叠，圆角收成云底） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M42.5,37 h23 a5.5,5.5 0 0,1 5.5,5.5 a5.5,5.5 0 0,1 -5.5,5.5 h-23 a5.5,5.5 0 0,1 -5.5,-5.5 a5.5,5.5 0 0,1 5.5,-5.5 z" />

    <!-- ========== NAS 主机：单层圆角矩形，白色 x=30..78 y=52..82 ========== -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M36,52 h36 a6,6 0 0,1 6,6 v18 a6,6 0 0,1 -6,6 h-36 a6,6 0 0,1 -6,-6 v-18 a6,6 0 0,1 6,-6 z" />

    <!-- ========== 磁盘槽位：两条蓝色圆角条（品牌蓝 #3478F6）========== -->
    <path
        android:fillColor="#FF3478F6"
        android:pathData="M39,58 h27 a2,2 0 0,1 2,2 v1 a2,2 0 0,1 -2,2 h-27 a2,2 0 0,1 -2,-2 v-1 a2,2 0 0,1 2,-2 z" />
    <path
        android:fillColor="#FF3478F6"
        android:pathData="M39,68 h27 a2,2 0 0,1 2,2 v1 a2,2 0 0,1 -2,2 h-27 a2,2 0 0,1 -2,-2 v-1 a2,2 0 0,1 2,-2 z" />

    <!-- ========== 状态灯：绿色圆点（运行中）对齐上层槽位 ========== -->
    <path
        android:fillColor="#FF25C275"
        android:pathData="M70.7,60.5 a1.3,1.3 0 1,0 2.6,0 a1.3,1.3 0 1,0 -2.6,0 z" />
</vector>