<?xml version="1.0" encoding="utf-8"?>
<!-- DDNAS 前景图标：品牌化简化形象 —— 云(上) + 双层硬盘盒(下)
     Adaptive-icon safe-zone: 中心 72x72（108 画布上 x=18..90, y=18..90），
     所有关键元素都落在 safe-zone 内，圆形 mask 不会裁掉主体。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ========== 云顶（上半圆弧形，暗示 "云端存储/同步"） ========== -->
    <!-- 云主体：三圆叠加 → 云朵剪影，白色填充 + 阴影 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M34,40
            a10,10 0 1,1 20,0
            a9,9 0 1,1 14,6
            a8,8 0 1,1 -12,8
            h-22
            a10,10 0 1,1 0,-14 z" />
    <!-- 云内字母 D（品牌首字母，蓝底白字做个小点缀 —— 不，直接留白，简洁点） -->

    <!-- ========== 连接：云到 NAS 的 "下降管"（暗示数据下沉到 NAS） ========== -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M50,50 h8 v8 h-8 z" />

    <!-- ========== 第一层硬盘柜（主）：圆角矩形 + 两磁盘 + 状态灯 ========== -->
    <!-- 柜体外轮廓 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M26,58
            h56
            a4,4 0 0,1 4,4
            v14
            a4,4 0 0,1 -4,4
            h-56
            a4,4 0 0,1 -4,-4
            v-14
            a4,4 0 0,1 4,-4 z" />
    <!-- 左硬盘槽 -->
    <path
        android:fillColor="#FF3478F6"
        android:pathData="
            M32,63
            h20
            a2,2 0 0,1 2,2
            v7
            a2,2 0 0,1 -2,2
            h-20
            a2,2 0 0,1 -2,-2
            v-7
            a2,2 0 0,1 2,-2 z" />
    <!-- 左硬盘盘片小圆圈（简化的盘片纹） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M36,67.5
            a2.5,2.5 0 1,0 5,0
            a2.5,2.5 0 1,0 -5,0 z" />
    <!-- 右硬盘槽 -->
    <path
        android:fillColor="#FF3478F6"
        android:pathData="
            M56,63
            h20
            a2,2 0 0,1 2,2
            v7
            a2,2 0 0,1 -2,2
            h-20
            a2,2 0 0,1 -2,-2
            v-7
            a2,2 0 0,1 2,-2 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M60,67.5
            a2.5,2.5 0 1,0 5,0
            a2.5,2.5 0 1,0 -5,0 z" />
    <!-- 状态灯（绿色小点 = 运行中） -->
    <path
        android:fillColor="#FF25C275"
        android:pathData="
            M79,73
            a1.5,1.5 0 1,0 3,0
            a1.5,1.5 0 1,0 -3,0 z" />

    <!-- ========== 第二层硬盘柜（副）：稍矮，整体更紧凑 ========== -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M30,80
            h48
            a3,3 0 0,1 3,3
            v11
            a3,3 0 0,1 -3,3
            h-48
            a3,3 0 0,1 -3,-3
            v-11
            a3,3 0 0,1 3,-3 z" />
    <!-- 二层左槽 -->
    <path
        android:fillColor="#FF3478F6"
        android:pathData="
            M35,84
            h16
            a1.5,1.5 0 0,1 1.5,1.5
            v5.5
            a1.5,1.5 0 0,1 -1.5,1.5
            h-16
            a1.5,1.5 0 0,1 -1.5,-1.5
            v-5.5
            a1.5,1.5 0 0,1 1.5,-1.5 z" />
    <!-- 二层右槽 -->
    <path
        android:fillColor="#FF3478F6"
        android:pathData="
            M55,84
            h16
            a1.5,1.5 0 0,1 1.5,1.5
            v5.5
            a1.5,1.5 0 0,1 -1.5,1.5
            h-16
            a1.5,1.5 0 0,1 -1.5,-1.5
            v-5.5
            a1.5,1.5 0 0,1 1.5,-1.5 z" />
    <!-- 二层状态灯 -->
    <path
        android:fillColor="#FF25C275"
        android:pathData="
            M75.5,91.5
            a1.2,1.2 0 1,0 2.4,0
            a1.2,1.2 0 1,0 -2.4,0 z" />
</vector>
