<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon 背景：品牌蓝线性渐变（左上浅 → 右下深），与 portal 首页 NAS 卡片渐变一致。
     Adaptive-icon background 层是 108x108dp 完整方形，系统按 mask 裁切为圆形/圆角方形。
     使用 <aapt:attr>+<gradient> 实现真渐变（API 24+ 支持，adaptive-icon 需 API 26+，安全）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="10" android:startY="10"
                android:endX="98" android:endY="98">
                <item android:offset="0" android:color="#FF5B9BFF" />
                <item android:offset="1" android:color="#FF2E6FE0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>